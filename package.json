{
  "name": "stela-shell",
  "version": "0.1.0",
  "private": true,
  "description": "StelaShell es una integracion para PI coding agent",
  "type": "module",
  "scripts": {
    "test": "node --experimental-strip-types --test extensions/subagents/tests/*.test.ts extensions/sessions/tests/*.test.ts extensions/web/tests/*.test.ts",
    "build:windows-helper": "cargo build --locked --release --manifest-path native/windows-job/Cargo.toml",
    "test:windows-helper": "cargo test --locked --manifest-path native/windows-job/Cargo.toml",
    "build:windows-sessions": "cargo build --locked --release --manifest-path native/windows-sessions/Cargo.toml",
    "test:windows-sessions": "cargo test --locked --manifest-path native/windows-sessions/Cargo.toml"
  },
  "pi": {
    "extensions": [
      "./extensions/method/index.ts",
      "./extensions/subagents/index.ts",
      "./extensions/sessions/index.ts",
      "./extensions/web/index.ts"
    ]
  },
  "dependencies": {
    "htmlparser2": "12.0.0"
  }
}
